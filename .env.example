# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/waterexchange

# Long random string used to sign login sessions (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public URL of the site (used for SEO metadata, sitemap and CORS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
