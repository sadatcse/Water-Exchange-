    "react-dom": "^19.2.0",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "mongodb": "^6.22.0",
